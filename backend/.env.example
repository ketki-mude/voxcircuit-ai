# Copy to backend/.env and fill in. backend/.env is gitignored; never commit real keys.

# PostgreSQL (local Homebrew). psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://localhost:5432/voxcircuit
# Used only by pytest. The test suite drops and recreates its schema on every run.
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/voxcircuit_test

# Comma-separated browser origins allowed to open /ws/call and call the API.
FRONTEND_ORIGINS=http://localhost:3000

# Gemini API key from https://aistudio.google.com/apikey (free tier, no billing).
# Leave empty to use only the offline test engine.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live

# Automatic voice activity detection: silence (ms) that ends a caller turn.
VAD_SILENCE_DURATION_MS=700

# Call caps
MAX_CALL_SECONDS=300
DAILY_CALL_CAP=20
MAX_TURNS=30

# Cost estimates in USD per minute of audio (paid-tier list prices; the free tier is $0).
# Edit these if pricing changes: https://ai.google.dev/gemini-api/docs/pricing
AUDIO_COST_PER_MIN_IN=0.005
AUDIO_COST_PER_MIN_OUT=0.018

# Signs caller tokens and team sign-in tokens. Use at least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If empty, a random key is generated at startup (everyone is signed out on restart).
APP_SECRET_KEY=

# Calendar and CRM: "mock" uses the in-process mocks under /mock/calendar and /mock/crm.
# "live" uses HubSpot and Google Calendar (see "Real integrations" in the README).
INTEGRATIONS_MODE=mock
# Consultation slots are offered on weekdays, 9:00 to 17:00, in this time zone.
BUSINESS_TIMEZONE=America/New_York
# A booking approval ticket expires after this many seconds.
APPROVAL_TTL_SECONDS=300

# INTEGRATIONS_MODE=live only. Use a test HubSpot account and a dedicated test calendar.
# HubSpot service key or legacy private app token, starting with pat-
# (scopes: crm.objects.contacts.read, crm.objects.contacts.write).
HUBSPOT_PRIVATE_APP_TOKEN=
# Google OAuth client of type "Desktop app", then run: python -m app.integrations.google_oauth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# The test calendar's ID, from its settings page ("Integrate calendar").
GOOGLE_CALENDAR_ID=
