# Copy to backend/.env and fill in. backend/.env is gitignored; never commit real keys.

# PostgreSQL (local Homebrew). psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://localhost:5432/voxcircuit
# Used only by pytest. The test suite drops and recreates its schema on every run.
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/voxcircuit_test

# Comma-separated browser origins allowed to open /ws/call and call the API.
FRONTEND_ORIGINS=http://localhost:3000

# Gemini API key from https://aistudio.google.com/apikey (free tier, no billing).
# Leave empty to use only the offline test engine.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live

# Automatic voice activity detection: silence (ms) that ends a caller turn.
VAD_SILENCE_DURATION_MS=700

# Call caps
MAX_CALL_SECONDS=300
DAILY_CALL_CAP=20
MAX_TURNS=30

# Cost estimates in USD per minute of audio (paid-tier list prices; the free tier is $0).
# Edit these if pricing changes: https://ai.google.dev/gemini-api/docs/pricing
AUDIO_COST_PER_MIN_IN=0.005
AUDIO_COST_PER_MIN_OUT=0.018
